# Patchium Environment Configuration

# Web UI Port
PORT=8080

# User and Group ID mapping for file ownership
PUID=1000
PGID=1000

# Timezone
TZ=Etc/UTC

# Java Memory Options for Morphe CLI
JAVA_OPTS=-Xms256m -Xmx2048m -XX:+UseContainerSupport

# Hot-Folder Watcher Configuration
AUTO_WATCH=true
WATCH_DEBOUNCE_SECONDS=5
WATCH_ACTION_AFTER_PATCH=archive

# Webhook Notifications (Optional: Discord, ntfy.sh, Gotify)
# WEBHOOK_URL=https://ntfy.sh/my-patchium-updates
# WEBHOOK_URL=https://discord.com/api/webhooks/...
WEBHOOK_URL=

# Patches Lifecycle & Updates
AUTO_UPDATE_PATCHES=true
MORPHE_PATCHES_REPO=MorpheApp/morphe-patches
